<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmcManager.Maui.Views.Controls.TagChipView"
             x:Name="Root">
    <Border x:Name="ChipBorder"
            Padding="10,4"
            StrokeThickness="1"
            MinimumHeightRequest="26"
            VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="13" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding SelectCommand, Source={x:Reference Root}}"
                                  CommandParameter="{Binding SelectParameter, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Label x:Name="ChipLabel"
               Text="{Binding Text, Source={x:Reference Root}}"
               Style="{StaticResource SocialTagChipLabelStyle}" />
    </Border>
</ContentView>
