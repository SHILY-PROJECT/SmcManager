<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmcManager.Maui.Views.Controls.AppHeaderView"
             x:Name="Root">
    <Border Padding="12,10,16,8"
            StrokeThickness="0"
            BackgroundColor="{DynamicResource BackgroundPrimary}">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            <Border WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="{DynamicResource BackgroundSecondary}"
                    Stroke="{DynamicResource Divider}"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <ImageButton x:Name="MenuButton"
                             Source="{DynamicResource MenuIcon}"
                             WidthRequest="44"
                             HeightRequest="44"
                             Padding="10"
                             BackgroundColor="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Clicked="OnMenuClicked"
                             SemanticProperties.Description="Меню" />
            </Border>
            <VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Spacing="2">
                <Label Text="{Binding Title, Source={x:Reference Root}}"
                       Style="{StaticResource SectionTitleStyle}"
                       FontSize="22"
                       IsVisible="{Binding ShowTitle, Source={x:Reference Root}}" />
                <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
                       Style="{StaticResource SectionSubtitleStyle}"
                       IsVisible="{Binding ShowSubtitle, Source={x:Reference Root}}" />
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="{DynamicResource BackgroundSecondary}"
                    Stroke="{DynamicResource Divider}"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <ImageButton x:Name="SettingsButton"
                             WidthRequest="44"
                             HeightRequest="44"
                             Padding="10"
                             BackgroundColor="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Clicked="OnSettingsClicked"
                             SemanticProperties.Description="Настройки" />
            </Border>
        </Grid>
    </Border>
</ContentView>
