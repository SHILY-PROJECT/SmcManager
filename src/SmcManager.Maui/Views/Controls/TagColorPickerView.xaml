<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmcManager.Maui.Views.Controls.TagColorPickerView"
             x:Name="Root"
             WidthRequest="48"
             HeightRequest="48">
    <Border x:Name="SwatchButton"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Stroke="{DynamicResource Divider}"
            StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOpenPicker" />
        </Border.GestureRecognizers>
        <Border x:Name="SelectedSwatchBorder"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
        </Border>
    </Border>
</ContentView>
