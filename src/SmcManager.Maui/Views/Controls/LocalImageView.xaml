<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmcManager.Maui.Views.Controls.LocalImageView"
             x:Name="Root">
    <Image x:Name="PreviewImage"
           Aspect="{Binding ImageAspect, Source={x:Reference Root}}"
           WidthRequest="{Binding ImageWidth, Source={x:Reference Root}}"
           HeightRequest="{Binding ImageHeight, Source={x:Reference Root}}" />
</ContentView>
