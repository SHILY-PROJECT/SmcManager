<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmcManager.Maui.ViewModels"
             xmlns:controls="clr-namespace:SmcManager.Maui.Views.Controls"
             x:Class="SmcManager.Maui.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Shell.NavBarIsVisible="False"
             Title="Контент"
             BackgroundColor="{DynamicResource BackgroundPrimary}">
    <Grid RowDefinitions="Auto,*">
        <controls:AppHeaderView Grid.Row="0"
                                Title="Контент"
                                ShowTitle="True" />
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <!-- ScrollView на всю ширину: полоса прокрутки у края экрана, как на «Главной» -->
            <ScrollView>
                <VerticalStackLayout Padding="20,8,20,16"
                                     Spacing="5">
                    <Label Text="Список пуст. Скачайте первый пост в разделе «Скачать»."
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"
                           Margin="12"
                           IsVisible="{Binding HasNoItems}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                         Spacing="5"
                                         IsVisible="{Binding HasNoItems, Converter={StaticResource InvertedBoolConverter}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContentItemDisplayModel">
                                <controls:ContentCardView Item="{Binding .}"
                                                          OpenCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenContentCommand}"
                                                          DeleteCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=DeleteItemCommand}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
