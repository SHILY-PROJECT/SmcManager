<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmcManager.Maui.ViewModels"
             xmlns:models="clr-namespace:SmcManager.Maui.Models"
             xmlns:core="clr-namespace:SmcManager.Core.Models;assembly=SmcManager.Core"
             xmlns:controls="clr-namespace:SmcManager.Maui.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="SmcManager.Maui.Views.DownloadPage"
             x:DataType="vm:DownloadViewModel"
             Shell.NavBarIsVisible="False"
             Title="Скачать"
             BackgroundColor="{DynamicResource BackgroundPrimary}">
    <Grid RowDefinitions="Auto,*">
        <controls:AppHeaderView Grid.Row="0"
                                Title="Скачать"
                                ShowTitle="True" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,16" Spacing="16">
                <Label Text="Ссылка на контент"
                       Style="{StaticResource SectionTitleStyle}" />

                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="8">
                    <Border Grid.Column="0"
                            Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding Url}"
                               Placeholder="Instagram, YouTube или VK..."
                               Style="{StaticResource EmojiCapableEntryStyle}"
                               TextColor="{DynamicResource TextPrimary}"
                               PlaceholderColor="{DynamicResource TextMuted}"
                               Margin="12,0,12,0"
                               VerticalOptions="Center" />
                    </Border>
                    <Button Grid.Column="1"
                            Text="×"
                            Style="{StaticResource SecondaryIconButtonStyle}"
                            FontSize="22"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center"
                            IsVisible="{Binding HasUrl}"
                            Command="{Binding ClearUrlCommand}"
                            SemanticProperties.Description="Очистить ссылку" />
                    <Button Grid.Column="2"
                            Style="{StaticResource DownloadIconButtonStyle}"
                            VerticalOptions="Center"
                            ImageSource="{DynamicResource PasteIcon}"
                            Command="{Binding PasteFromClipboardCommand}"
                            SemanticProperties.Description="Вставить из буфера" />
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsLoadingLinkMetadata}"
                                   IsVisible="{Binding IsLoadingLinkMetadata}"
                                   Color="{DynamicResource AccentPrimary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0,24,0,24" />

                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding ShowLinkMetadataReady}">
                    <VerticalStackLayout Spacing="6"
                                         IsVisible="{Binding ShowAccountPicker}">
                        <Label Text="Аккаунт"
                               Style="{StaticResource SectionSubtitleStyle}" />
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Border Style="{StaticResource InputBorderStyle}">
                                <Picker ItemsSource="{Binding AccountOptions}"
                                        ItemDisplayBinding="{Binding Title}"
                                        SelectedItem="{Binding SelectedAccountOption}"
                                        Title="Выберите аккаунт"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimary}" />
                            </Border>
                        </Border>
                        <Label Text="{Binding AccountPickerHint}"
                               Style="{StaticResource SectionSubtitleStyle}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="14">
                            <Grid Padding="0,0,0,4">
                                <Grid ColumnDefinitions="88,*"
                                      ColumnSpacing="14">
                                    <Border WidthRequest="80"
                                            HeightRequest="80"
                                            StrokeThickness="0"
                                            BackgroundColor="{DynamicResource BackgroundSecondary}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding PreviewImageSource}"
                                               Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding PreviewAuthor}"
                                               Style="{StaticResource EmojiCapableLabelStyle}"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}"
                                               FontSize="15"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               Margin="0,0,8,0" />
                                        <Label Text="{Binding PreviewTitle}"
                                               Style="{StaticResource EmojiCapableLabelStyle}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="3" />
                                    </VerticalStackLayout>
                                </Grid>
                                <HorizontalStackLayout HorizontalOptions="End"
                                                       VerticalOptions="Start"
                                                       Spacing="6"
                                                       IsVisible="{Binding ShowPreviewAccountIndicators}">
                                    <Image Source="{Binding PreviewAuthStatusIconFile}"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           Aspect="AspectFit"
                                           VerticalOptions="Center"
                                           SemanticProperties.Description="{Binding PreviewAuthStatusDescription}" />
                                    <Image Source="{Binding PreviewPlatformIconFile}"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           Aspect="AspectFit"
                                           VerticalOptions="Center"
                                           SemanticProperties.Description="Соцсеть" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Picker ItemsSource="{Binding QualityOptions}"
                                    ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding SelectedQuality}"
                                    IsVisible="{Binding ShowQualityPicker}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource TextPrimary}" />

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  HeightRequest="40">
                                    <CollectionView Grid.Column="0"
                                                    ItemsSource="{Binding TagChips}"
                                                    HeightRequest="40"
                                                    SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.Header>
                                            <controls:TagChipView Text="Без тега"
                                                                  Margin="0,0,6,0"
                                                                  IsSelected="{Binding IsNoTagSelected, Source={RelativeSource AncestorType={x:Type vm:DownloadViewModel}}}"
                                                                  SelectCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadViewModel}}, Path=ClearTagCommand}" />
                                        </CollectionView.Header>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChipViewModel">
                                                <controls:TagChipView Text="{Binding Name}"
                                                                      ColorHex="{Binding ColorHex}"
                                                                      IsSelected="{Binding IsSelected}"
                                                                      SelectCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadViewModel}}, Path=SelectTagChipCommand}"
                                                                      SelectParameter="{Binding .}" />
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <ImageButton Grid.Column="1"
                                                 WidthRequest="40"
                                                 HeightRequest="40"
                                                 Style="{StaticResource TagRowActionButtonStyle}"
                                                 Source="{DynamicResource AddTagIcon}"
                                                 VerticalOptions="Center"
                                                 Command="{Binding ToggleNewTagPanelCommand}"
                                                 SemanticProperties.Description="Добавить новый тег" />
                            </Grid>

                            <VerticalStackLayout Spacing="14"
                                                 IsVisible="{Binding IsNewTagPanelVisible}">
                                <Label Text="Новый тег"
                                       Style="{StaticResource SectionTitleStyle}"
                                       FontSize="18" />
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="8">
                                    <Border Grid.Column="0"
                                            Style="{StaticResource InputBorderStyle}"
                                            HeightRequest="48"
                                            VerticalOptions="Center">
                                        <Entry Text="{Binding NewTagName}"
                                               Placeholder="Название тега (можно с эмодзи 🍕)"
                                               Style="{StaticResource EmojiCapableEntryStyle}"
                                               TextColor="{DynamicResource TextPrimary}"
                                               PlaceholderColor="{DynamicResource TextMuted}"
                                               MaxLength="32"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <controls:TagColorPickerView Grid.Column="1"
                                                                 SelectedColor="{Binding SelectedTagColor}"
                                                                 VerticalOptions="Center" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource PrimaryIconButtonStyle}"
                                            VerticalOptions="Center"
                                            ImageSource="{DynamicResource AddTagIcon}"
                                            Command="{Binding AddTagCommand}"
                                            SemanticProperties.Description="Добавить тег" />
                                </Grid>
                                <Label Text="{Binding NewTagStatusMessage}"
                                       Style="{StaticResource EmojiCapableLabelStyle}"
                                       TextColor="{DynamicResource AccentSecondary}"
                                       FontSize="13" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="8"
                                                   HorizontalOptions="End">
                                <Button x:Name="DismissPreviewButton"
                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="8"
                                        MinimumWidthRequest="40"
                                        MinimumHeightRequest="40"
                                        ImageSource="{DynamicResource DeleteIcon}"
                                        Command="{Binding DismissPreviewCommand}"
                                        SemanticProperties.Description="Закрыть предпросмотр" />
                                <Button Style="{StaticResource DownloadIconButtonStyle}"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="8"
                                        MinimumWidthRequest="40"
                                        MinimumHeightRequest="40"
                                        ImageSource="{DynamicResource DownloadButtonIcon}"
                                        IsVisible="{Binding ShowPreviewDownloadButton}"
                                        Command="{Binding DownloadCommand}"
                                        SemanticProperties.Description="Скачать" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Style="{StaticResource DownloadIconButtonStyle}"
                        HorizontalOptions="End"
                        ImageSource="{DynamicResource DownloadButtonIcon}"
                        IsVisible="{Binding ShowFallbackDownloadButton}"
                        Command="{Binding DownloadCommand}"
                        SemanticProperties.Description="Скачать" />

                <Label Text="Скачивания"
                       Style="{StaticResource SectionSubtitleStyle}"
                       IsVisible="{Binding HasActiveDownloads}" />

                <CollectionView ItemsSource="{Binding ActiveDownloads}"
                                IsVisible="{Binding HasActiveDownloads}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PendingDownloadViewModel">
                            <Border Style="{StaticResource CardBorderStyle}"
                                    Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding DisplayTitle}"
                                                   Style="{StaticResource EmojiCapableLabelStyle}"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   FontSize="14"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Text="{Binding DisplaySubtitle}"
                                                   Style="{StaticResource EmojiCapableLabelStyle}"
                                                   TextColor="{DynamicResource TextMuted}"
                                                   FontSize="12"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="×"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Padding="0"
                                                IsVisible="{Binding IsFinished}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadViewModel}}, Path=DismissDownloadJobCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding Progress}"
                                                 ProgressColor="{DynamicResource DownloadAccent}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Status}"
                                               Style="{StaticResource EmojiCapableLabelStyle}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               FontSize="12"
                                               LineBreakMode="WordWrap" />
                                        <ActivityIndicator Grid.Column="1"
                                                           IsRunning="{Binding IsActive}"
                                                           IsVisible="{Binding IsActive}"
                                                           Color="{DynamicResource AccentPrimary}"
                                                           HeightRequest="20"
                                                           WidthRequest="20" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource EmojiCapableLabelStyle}"
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="13" />

                <Label Text="{Binding RecentDownloadsHeader}"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,12,0,0" />

                <CollectionView ItemsSource="{Binding RecentDownloads}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label Text="Пока ничего не скачано"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalOptions="Center"
                               Margin="12" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContentItemDisplayModel">
                            <controls:ContentCardView Item="{Binding .}"
                                                      DeleteCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadViewModel}}, Path=DeleteRecentItemCommand}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
